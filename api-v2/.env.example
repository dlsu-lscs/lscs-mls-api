# api-v2 environment variables.
# Copy this file to api-v2/.env and fill in the values: cp .env.example .env
# .env is git-ignored. Never commit real credentials; staging and production
# values belong in the hosting platform's secret settings.

# ==============================================
# SERVER (optional)
# ==============================================
# Port the API listens on. Default: 3000
PORT=3000
# Interface the API binds to. Default: localhost. Use 0.0.0.0 inside a container.
HOST=localhost

# ==============================================
# CORS (optional)
# ==============================================
# Comma-separated browser origins allowed to call the API: scheme, host and
# optional port only, no paths and no "*". Default: http://localhost:3001
CORS_ORIGINS=http://localhost:3001

# ==============================================
# DATABASE (required: the server does not start without it)
# ==============================================
# PostgreSQL connection string, also used by drizzle-kit.
DB_URL=postgresql://user:password@localhost:5432/mls_api_v2

# ==============================================
# AUTHENTICATION (required for sign-in)
# ==============================================
# Secret used to sign the API's JWTs. Use a long random value.
JWT_SECRET=

# Google OAuth client for the /auth routes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ==============================================
# ARCHERSHUB COURSE SCRAPER (only for POST /courses/fetch)
# ==============================================
# ArchersHub account the scraper logs in with.
AH_USERNAME=
AH_PASSWORD=
# Gmail account that receives the ArchersHub OTP email, read over IMAP.
# Use a Gmail app password, not the account password.
AH_GMAIL_ADDRESS=
AH_GMAIL_PASSWORD=
